# SWIRL for Backstage image defaults (TECH_DESIGN_swirl_for_backstage.md 3.8).
#
# One container, one /data volume: SQLite, Redis and the Tantivy index all live
# under /data. Override any of these with `environment:` in compose or `env:` in
# the Kubernetes manifest.
#
# SECRET_KEY below is the same development placeholder .env.dist ships. Replace
# it for any deployment that is reachable by anyone else.
SECRET_KEY=django-insecure-4*@!3sf)-t=jvww$27w#_gv9!18+8cj9(+e$#w8*#umln$jjf$
ALLOWED_HOSTS=localhost,127.0.0.1,swirl
PROTOCOL=http
SWIRL_EXPLAIN=True

# Database: SQLite on the volume.
SQL_ENGINE=django.db.backends.sqlite3
SQL_DATABASE=/data/db.sqlite3
SQL_USER=user
SQL_PASSWORD=password
SQL_HOST=localhost
SQL_PORT=5432

# Redis is started inside the container by docker/backstage/entrypoint.sh.
CELERY_BROKER_URL='redis://127.0.0.1:6379/0'
CELERY_RESULT_BACKEND='redis://127.0.0.1:6379/0'

# Tantivy index (TECH_DESIGN section 3.1).
SWIRL_TANTIVY_DATA_DIR=/data/tantivy
SWIRL_TANTIVY_WRITER_HEAP_MB=64
SWIRL_TANTIVY_BEGIN_TTL=7200

# One small spaCy model only. swirl/spacy.py reads this; the image build also
# repoints Presidio's default NLP configuration at the same model.
SWIRL_SPACY_MODEL_EN=en_core_web_sm

MICROSOFT_CLIENT_ID=''
MICROSOFT_CLIENT_SECRET=''
MICROSOFT_REDIRECT_URI=''
CSRF_TRUSTED_ORIGINS='http://localhost:8000'
